{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aktobly",
  "version": "0.1.0",
  "identifier": "com.aktobly.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Aktobly",
        "width": 420,
        "height": 520,
        "minWidth": 360,
        "minHeight": 420,
        "maxWidth": 760,
        "maxHeight": 960,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Productivity",
    "shortDescription": "Local AI writing assistant (Meta Llama via Ollama)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
